# ============================================================
# TFAEL-OMNI — Konfigurasi Produksi (TEMPLATE)
# ------------------------------------------------------------
# Salin file ini jadi  deploy/omni.env  lalu isi nilainya.
# deploy/omni.env BERISI RAHASIA dan sudah diabaikan git (.gitignore).
# Skrip start-prod.sh akan membuat & mengisi otomatis bila belum ada.
# ============================================================

# Origin (domain) yang boleh akses lintas-asal, dipisah koma.
# KOSONG = tolak semua CORS (default paling aman).
# Saat masih uji coba lokal, cukup localhost. Ganti ke domain Anda saat online.
OMNI_ALLOWED_ORIGINS="http://localhost:8080,https://localhost:8443"
# Contoh saat sudah punya domain:
# OMNI_ALLOWED_ORIGINS="https://omni.example.com"

# Kunci pra-berbagi untuk endpoint perangkat lapangan. KOSONG = terbuka (demo).
# Diisi acak oleh start-prod.sh bila dibiarkan kosong.
OMNI_AGENT_KEY=""

# Kata sandi awal akun seed. KOSONG = dibangkitkan acak & tampil sekali di log boot.
# Diisi acak oleh start-prod.sh bila dibiarkan kosong.
OMNI_BOOTSTRAP_PASSWORD=""

# Kebijakan lockout login (anti brute-force).
OMNI_LOGIN_MAX_FAILS="5"
OMNI_LOGIN_LOCK_SECONDS="900"

# 1 = matikan panggilan jaringan keluar (GeoIP host) agar benar-benar air-gapped.
OMNI_AIRGAP="1"
